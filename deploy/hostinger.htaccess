# Mirrors deploy/Caddyfile for Hostinger (Apache/LiteSpeed)
RewriteEngine On
RewriteCond %{HTTP_HOST} ^www\.storyglass\.studio$ [NC]
RewriteRule ^(.*)$ https://storyglass.studio/$1 [R=301,L]
RewriteCond %{HTTPS} off
RewriteCond %{HTTP_HOST} ^storyglass\.studio$ [NC]
RewriteRule ^(.*)$ https://storyglass.studio/$1 [R=301,L]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  <FilesMatch "^(index\.html|films\.json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  <If "%{REQUEST_URI} =~ m#^/media/#">
    ExpiresDefault "access plus 7 days"
  </If>
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
